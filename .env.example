# Kopieren nach .env und anpassen:  cp .env.example .env

# --- Anmeldung (Pflicht) ---
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=bitte-aendern
# Zufälliger Schlüssel für das Sitzungs-Cookie, z. B.: openssl rand -hex 32
# Leer = bei jedem Neustart neuer Schlüssel (alle müssen sich neu anmelden).
SESSION_SECRET=

# --- Erreichbarkeit ---
# Port auf dem Host
DASHBOARD_PORT=8080
# Adresse, an die der Port gebunden wird. 0.0.0.0 = alle Schnittstellen.
# Besser: LAN-IP (z. B. 192.168.1.10) oder Tailscale-IP (100.x.y.z).
BIND_ADDRESS=0.0.0.0
# Nur auf true setzen, wenn das Dashboard per HTTPS aufgerufen wird
# (z. B. hinter Tailscale Serve oder einem Reverse-Proxy).
COOKIE_SECURE=false
# Sitzungsdauer in Sekunden (12 Stunden)
SESSION_MAX_AGE=43200

# --- Zeitzone für Anzeige und Logs ---
TZ=Europe/Berlin

# --- Docker ---
# API-Version für den Docker-Daemon. 1.44 passt für Docker 25 und neuer.
# Für ältere Docker-Versionen z. B. 1.41 (Docker 20.10) eintragen.
DOCKER_API_VERSION=1.44
# Version des Socket-Proxy-Images (am besten eine feste Version eintragen)
SOCKET_PROXY_TAG=latest

# --- Anzeige ---
REFRESH_SECONDS=15
LOG_TAIL=200
# Restart-Schleife: so viele Restarts ...
RESTART_LOOP_THRESHOLD=3
# ... innerhalb dieses Zeitfensters in Sekunden
RESTART_LOOP_WINDOW=600
# true = sauber beendete Container (Exit-Code 0) nicht als auffällig markieren
IGNORE_EXIT_ZERO=false

# --- Aktionslog ---
ACTION_LOG_MAX=1000

# --- Login-Bremse ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_SECONDS=300
